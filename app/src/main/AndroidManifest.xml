<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the feed check which app is calling it. -->
    <queries>
        <package android:name="com.solina.launcher" />
        <package android:name="com.solina.launcher.nightly" />
        <package android:name="com.solina.launcher.play" />
        <package android:name="com.solina.launcher.debug" />
        <package android:name="com.solina.launcher.nightly.debug" />
        <package android:name="com.solina.launcher.play.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="false" />

        <!-- Solina Launcher binds to this service to show the feed page. -->
        <service
            android:name=".OverlayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
                <data android:scheme="app" />
            </intent-filter>
            <meta-data
                android:name="service.api.version"
                android:value="4" />
        </service>

    </application>
</manifest>
